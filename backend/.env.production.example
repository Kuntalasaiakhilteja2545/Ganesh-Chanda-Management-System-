# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=your-production-secret-key-generate-with-openssl-rand-base64-32

# Debug
DEBUG=False

# Database (Railway auto-provides these via environment variables)
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=auto-generated
# DB_HOST=auto-generated
# DB_PORT=auto-generated

# CORS - Frontend URLs allowed to call the API
CORS_ALLOWED_ORIGINS=https://ganesh-chanda-frontend.netlify.app,https://your-custom-domain.org

# JWT Token Lifetimes (in minutes)
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1440